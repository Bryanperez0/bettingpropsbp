# Copy to .env for `netlify dev`, and add the same variables in
# Netlify > Site configuration > Environment variables for production.
# These are read ONLY by Netlify Functions. Never prefix them with VITE_.

# --- Required for real player prop lines -----------------------------------
# The Odds API (https://the-odds-api.com). Player props come from the
# per-event odds endpoint. Cost per refresh = markets x regions x games.
ODDS_API_KEY=

# --- Optional tuning ---------------------------------------------------------
# Bookmaker region(s) for The Odds API. "us" covers DraftKings, FanDuel, etc.
ODDS_API_REGIONS=us
# Comma-separated bookmaker keys to keep (blank = all books returned).
ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us
# Comma-separated prop markets to request. Fewer markets = fewer credits.
ODDS_API_MARKETS=player_pass_yds,player_pass_tds,player_pass_completions,player_pass_attempts,player_rush_yds,player_rush_attempts,player_reception_yds,player_receptions,player_reception_longest,player_anytime_td
# Minutes to reuse cached prop lines before spending credits again.
ODDS_CACHE_MINUTES=60
# Only fetch props for games kicking off within this many hours.
ODDS_LOOKAHEAD_HOURS=96

# Include last season's games as a (down-weighted) prior early in the season.
INCLUDE_PRIOR_SEASON=true

# Shows clearly-labeled DEMO lines (player's recent median) when no sportsbook
# lines are available. Demo lines are never tracked in Model Performance.
DEMO_PROP_LINES=false

# Optional shared secret for POST /api/refresh (manual refresh button).
# Leave blank to allow refreshes (they are still rate-limited by the caches).
REFRESH_SECRET=
